  - {fileID: 114350483966680816}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966680817}
  m_BlockName: Sand Glitter Init
  m_HLSLCode: "#include \"Assets/2-Art/2-VFX/CharacterDissolve/Shader/SandDissolveNoise.hlsl\"\nvoid
    SandGlitterInit(inout VFXAttributes attributes, in float3 pos, in float3 nrm,
    in float edgeH, in float edgeDir, in float noiseScale, in float noiseAmount,
    in float band, in float gather, in float3 wind, in float4 glow, in float size)\n{\n   
    float d = SD_EdgeDistance(pos, edgeH, edgeDir, noiseScale, noiseAmount);\n   
    if (abs(d) > band * 0.6) { attributes.alive = false; return; }\n    uint id =
    attributes.particleId * 23u + 5u;\n    float r0 = FixedRand(id);\n    float r1
    = FixedRand(id + 1u);\n    float r2 = FixedRand(id + 2u);\n    float3 n = normalize(nrm
    + 1e-5);\n    attributes.color = glow.rgb * lerp(0.5, 1.3, r0);\n    attributes.size
    = size * lerp(0.5, 1.3, r1);\n    attributes.lifetime = lerp(0.5, 1.4, r2);\n   
    attributes.position = pos + n * 0.004;\n    attributes.velocity = r2 < gather
    ? -n * 0.03 : n * 0.05 + wind * 0.25 + float3(0, 0.06, 0);\n    attributes.alpha
    = 0.0;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SandGlitterInit
    selectedIndex: 0
