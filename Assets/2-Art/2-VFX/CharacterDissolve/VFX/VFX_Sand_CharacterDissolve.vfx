  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Operator.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966674976}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966680852}
  - {fileID: 114350483966680853}
  - {fileID: 114350483966680854}
  - {fileID: 114350483966680855}
  m_OutputSlots:
  - {fileID: 114350483966680856}
  m_OperatorName: Sand Pick Triangle
  m_HLSLCode: "uint SandPickTri(in uint id, in uint salt, in uint triCount, in VFXSampler2D
    triLut)\n{\n    // LUT de triangulos ponderada por area (1024x16 RFloat); sin
    LUT -> indice uniforme\n    float r = FixedRand(id * 13u + salt);\n    uint w,
    h;\n    triLut.t.GetDimensions(w, h);\n    uint tri = (uint)(r * triCount);\n   
    if (w == 1024u && h == 16u) { uint k = min((uint)(r * 16384.0), 16383u); tri
    = (uint)LoadTexture(triLut, int3(k % 1024u, k / 1024u, 0)).r; }\n    return min(tri,
    max(triCount, 1u) - 1u);\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunctions:
    selection: SandPickTri
    selectedIndex: 0
