  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966680843}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966680960}
  - {fileID: 114350483966680964}
  - {fileID: 114350483966680968}
  - {fileID: 114350483966680969}
  - {fileID: 114350483966680970}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966680971}
  m_BlockName: Sand Shell Update
  m_HLSLCode: "#include \"Assets/2-Art/2-VFX/CharacterDissolve/Shader/SandDissolveNoise.hlsl\"\nvoid
    SandShellUpdate(inout VFXAttributes attributes, in float3 pos, in float3 nrm,
    in float edgeH, in float noiseScale, in float noiseAmount)\n{\n    // Pegado
    al cuerpo (se re-muestrea el mismo punto del skinned mesh cada frame) con un
    leve flotar\n    uint id = attributes.particleId * 29u + 1u;\n    float3 n =
    normalize(nrm + 1e-5);\n    float hover = lerp(0.0, 0.018, FixedRand(id + 3u));\n   
    float3 drift = (float3(FixedRand(id + 4u), FixedRand(id + 5u), FixedRand(id +
    6u)) - 0.5) * 0.05;\n    attributes.position = pos + n * hover + drift * attributes.age;\n   
    attributes.velocity = float3(0, 0, 0);\n    float life = saturate(attributes.age
    / max(attributes.lifetime, 1e-3));\n    // Donde el cuerpo ya se ha formado el
    polvo se funde\n    float d = SD_EdgeDistance(pos, edgeH, 1.0, noiseScale, noiseAmount);\n   
    float s = smoothstep(0.0, 0.2, life) * (1.0 - smoothstep(0.7, 1.0, life)) * (1.0
    - smoothstep(-0.015, 0.01, d));\n    attributes.scaleX = s;\n    attributes.scaleY
    = s;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SandShellUpdate
    selectedIndex: 0
