  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966681004}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966681069}
  - {fileID: 114350483966681073}
  - {fileID: 114350483966681077}
  - {fileID: 114350483966681078}
  - {fileID: 114350483966681079}
  - {fileID: 114350483966681080}
  - {fileID: 114350483966681081}
  - {fileID: 114350483966681082}
  - {fileID: 114350483966681087}
  - {fileID: 114350483966681092}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966681093}
  m_BlockName: Sand Swirl Init
  m_HLSLCode: "void SandSwirlInit(inout VFXAttributes attributes, in float3 pos,
    in float3 center, in float bodyHeight, in float radius, in float travelBase,
    in float travelSpread, in float freeChance, in float4 sandA, in float4 sandB,
    in float size)\n{\n    uint id = attributes.particleId * 31u + 9u;\n    float
    r0 = FixedRand(id);\n    float r1 = FixedRand(id + 1u);\n    float r2 = FixedRand(id
    + 2u);\n    float r3 = FixedRand(id + 3u);\n    float h = saturate((pos.y - center.y)
    / max(bodyHeight, 0.1));\n    float travel = travelBase * lerp(0.75, 1.25, r0)
    + travelSpread * h;\n    bool freeMote = r1 < freeChance;\n    attributes.mass
    = freeMote ? -travel : travel;\n    attributes.lifetime = freeMote ? travel :
    travel + 60.0;\n    attributes.color = lerp(sandB.rgb, sandA.rgb, r2) * 1.1;\n   
    attributes.size = size * (freeMote ? lerp(0.8, 1.6, r3) : lerp(0.45, 0.95, r3));\n   
    attributes.alpha = 0.0;\n    attributes.velocity = float3(0, 0, 0);\n    attributes.position
    = center + float3(0, 0.02, 0);\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SandSwirlInit
    selectedIndex: 0
