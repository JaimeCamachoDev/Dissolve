  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966681019}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966681138}
  - {fileID: 114350483966681142}
  - {fileID: 114350483966681146}
  - {fileID: 114350483966681150}
  - {fileID: 114350483966681151}
  - {fileID: 114350483966681152}
  - {fileID: 114350483966681153}
  - {fileID: 114350483966681154}
  - {fileID: 114350483966681155}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966681156}
  m_BlockName: Sand Swirl Update
  m_HLSLCode: "#include \"Assets/2-Art/2-VFX/CharacterDissolve/Shader/SandDissolveNoise.hlsl\"\nvoid
    SandSwirlUpdate(inout VFXAttributes attributes, in float3 pos, in float3 nrm,
    in float3 center, in float radius, in float turns, in float edgeH, in float edgeDir,
    in float noiseScale, in float noiseAmount)\n{\n    uint id = attributes.particleId
    * 31u + 9u;\n    float r4 = FixedRand(id + 4u);\n    float r5 = FixedRand(id
    + 5u);\n    float r6 = FixedRand(id + 6u);\n    float r7 = FixedRand(id + 7u);\n   
    bool freeMote = attributes.mass < 0.0;\n    float travel = max(abs(attributes.mass),
    1e-3);\n    float e = saturate(attributes.age / travel);\n    float3 n = normalize(nrm
    + 1e-5);\n    float3 target = pos + n * lerp(0.0, 0.012, r7);\n\n    // Espiral
    alrededor del personaje: angulo, radio y altura van del suelo al punto del cuerpo\n   
    float twoPi = 6.2831853;\n    float a0 = r4 * twoPi;\n    float r0 = radius *
    lerp(0.7, 1.35, r5);\n    float2 rel = target.xz - center.xz;\n    float at =
    atan2(rel.y, rel.x);\n    float dA = at - a0;\n    dA -= twoPi * round(dA / twoPi);\n   
    dA += (r6 > 0.5 ? 1.0 : -1.0) * turns * twoPi;\n    // Columna: sube girando
    con radio casi constante y solo al final se cierra sobre el cuerpo\n    float
    eA = 1.0 - (1.0 - e) * (1.0 - e);\n    float eR = smoothstep(0.45, 1.0, e);\n   
    float ang = a0 + dA * eA;\n    float rad = lerp(r0, length(rel), eR);\n    float
    y = lerp(center.y + 0.03 + 0.15 * r7, target.y, smoothstep(0.0, 0.8, e));\n   
    float3 p = float3(center.x + cos(ang) * rad, y, center.z + sin(ang) * rad);\n   
    if (!freeMote) p = lerp(p, target, smoothstep(0.85, 1.0, e));\n\n    // Ya posado:
    polvo vivo, respira un poco\n    float tw = 0.65 + 0.35 * sin(attributes.age
    * (3.0 + 5.0 * r5) + r4 * twoPi);\n    float3 breath = (float3(r5, r6, r7) -
    0.5) * 0.006 * sin(attributes.age * 2.0 + r6 * twoPi);\n    attributes.position
    = (freeMote || e < 1.0) ? p : target + breath;\n    attributes.velocity = float3(0,
    0, 0);\n\n    // El borde del material lo absorbe (estatua de arena por encima
    del borde)\n    float d = SD_EdgeDistance(pos, edgeH, edgeDir, noiseScale, noiseAmount);\n   
    float absorb = 1.0 - smoothstep(-0.04, 0.005, d);\n    if (d > 0.01 && (e >=
    1.0 || freeMote)) { attributes.alive = false; return; }\n\n    float fade = smoothstep(0.0,
    0.12, e);\n    if (freeMote) fade *= 1.0 - smoothstep(0.6, 1.0, e);\n    attributes.alpha
    = fade * absorb * tw;\n    attributes.scaleX = absorb;\n    attributes.scaleY
    = absorb;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SandSwirlUpdate
    selectedIndex: 0
