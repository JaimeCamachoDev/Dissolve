  - {fileID: 114350483966680903}
  - {fileID: 114350483966680904}
  - {fileID: 114350483966680909}
  - {fileID: 114350483966680914}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966680915}
  m_BlockName: Sand Shell Init
  m_HLSLCode: "#include \"Assets/2-Art/2-VFX/CharacterDissolve/Shader/SandDissolveNoise.hlsl\"\nvoid
    SandShellInit(inout VFXAttributes attributes, in float3 pos, in float3 nrm, in
    float edgeH, in float noiseScale, in float noiseAmount, in float4 sandA, in float4
    sandB, in float size)\n{\n    // Silueta de polvo: solo sobre la parte del cuerpo
    que aun no es visible\n    float d = SD_EdgeDistance(pos, edgeH, 1.0, noiseScale,
    noiseAmount);\n    if (d > -0.01) { attributes.alive = false; return; }\n   
    uint id = attributes.particleId * 29u + 1u;\n    float r0 = FixedRand(id);\n   
    float r1 = FixedRand(id + 1u);\n    float r2 = FixedRand(id + 2u);\n    attributes.color
    = lerp(sandB.rgb, sandA.rgb, r0 * r0) * 1.35;\n    attributes.size = size * lerp(0.7,
    1.4, r1);\n    attributes.lifetime = lerp(0.5, 1.1, r2);\n    attributes.texIndex
    = floor(r1 * 15.99);\n    attributes.position = pos;\n    attributes.velocity
    = float3(0, 0, 0);\n    attributes.scaleX = 0.0;\n    attributes.scaleY = 0.0;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SandShellInit
    selectedIndex: 0
