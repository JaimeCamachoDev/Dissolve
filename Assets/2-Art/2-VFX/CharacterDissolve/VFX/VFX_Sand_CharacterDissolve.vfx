  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966680469}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966680534}
  - {fileID: 114350483966680538}
  - {fileID: 114350483966680542}
  - {fileID: 114350483966680543}
  - {fileID: 114350483966680544}
  - {fileID: 114350483966680545}
  - {fileID: 114350483966680546}
  - {fileID: 114350483966680547}
  - {fileID: 114350483966680551}
  - {fileID: 114350483966680552}
  - {fileID: 114350483966680557}
  - {fileID: 114350483966680562}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966680563}
  m_BlockName: Sand Grain Init
  m_HLSLCode: "#include \"Assets/2-Art/2-VFX/CharacterDissolve/Shader/SandDissolveNoise.hlsl\"\nvoid
    SandGrainInit(inout VFXAttributes attributes, in float3 pos, in float3 nrm, in
    float edgeH, in float noiseScale, in float noiseAmount, in float band, in float
    gather, in float3 wind, in float travel, in float4 sandA, in float4 sandB, in
    float size)\n{\n    // Solo nace en la franja del borde (mismo ruido que el material)\n   
    float d = SD_EdgeDistance(pos, edgeH, 1.0, noiseScale, noiseAmount);\n    if
    (d < -band || d > band * 0.35) { attributes.alive = false; return; }\n    uint
    id = attributes.particleId * 11u + 7u;\n    float r0 = FixedRand(id);\n    float
    r1 = FixedRand(id + 1u);\n    float r2 = FixedRand(id + 2u);\n    float r3 =
    FixedRand(id + 3u);\n    float3 n = normalize(nrm + 1e-5);\n    float3 rnd =
    normalize(float3(FixedRand(id + 4u), FixedRand(id + 5u), FixedRand(id + 6u))
    - 0.5 + 1e-4);\n    attributes.color = lerp(sandB.rgb, sandA.rgb, r0) * 1.35;
    // Stone3 es gris: se compensa\n    attributes.size = size * lerp(0.45, 1.4,
    r1 * r1);\n    attributes.texIndex = floor(r3 * 15.99);\n    attributes.alpha
    = 1.0;\n    attributes.targetPosition = pos;\n    if (r2 < gather)\n    {\n       
    // Aparecer: el grano llega desde el aire hasta su sitio en el cuerpo\n       
    float life = lerp(0.7, 1.4, r3);\n        float3 off = (n * 0.5 + rnd * 0.6 -
    normalize(wind + 1e-4) * 0.6 + float3(0, 0.25, 0)) * travel * lerp(0.5, 1.2,
    r1);\n        attributes.lifetime = life;\n        attributes.position = pos
    + off;\n        attributes.velocity = -off / life;\n        attributes.mass =
    2.0;\n    }\n    else\n    {\n        // Disolver: se desprende y se lo lleva
    el viento\n        attributes.lifetime = lerp(1.4, 3.2, r3);\n        attributes.position
    = pos + n * 0.003;\n        attributes.velocity = n * lerp(0.03, 0.15, r1) +
    wind * lerp(0.15, 0.55, r0) + rnd * 0.05;\n        attributes.mass = 1.0;\n   
    }\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SandGrainInit
    selectedIndex: 0
