  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966680603}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966680668}
  - {fileID: 114350483966680672}
  - {fileID: 114350483966680676}
  - {fileID: 114350483966680677}
  - {fileID: 114350483966680678}
  - {fileID: 114350483966680679}
  - {fileID: 114350483966680680}
  - {fileID: 114350483966680681}
  - {fileID: 114350483966680685}
  - {fileID: 114350483966680686}
  - {fileID: 114350483966680691}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966680692}
  m_BlockName: Sand Puff Init
  m_HLSLCode: "#include \"Assets/2-Art/2-VFX/CharacterDissolve/Shader/SandDissolveNoise.hlsl\"\nvoid
    SandPuffInit(inout VFXAttributes attributes, in float3 pos, in float3 nrm, in
    float edgeH, in float noiseScale, in float noiseAmount, in float band, in float
    gather, in float3 wind, in float travel, in float4 sandA, in float size)\n{\n   
    float d = SD_EdgeDistance(pos, edgeH, 1.0, noiseScale, noiseAmount);\n    if
    (d < -band * 1.5 || d > band * 0.5) { attributes.alive = false; return; }\n   
    uint id = attributes.particleId * 17u + 3u;\n    float r0 = FixedRand(id);\n   
    float r1 = FixedRand(id + 1u);\n    float r2 = FixedRand(id + 2u);\n    float3
    n = normalize(nrm + 1e-5);\n    float3 rnd = normalize(float3(FixedRand(id +
    4u), FixedRand(id + 5u), FixedRand(id + 6u)) - 0.5 + 1e-4);\n    attributes.color
    = sandA.rgb * lerp(0.55, 0.8, r0);\n    attributes.size = size * lerp(4.0, 9.0,
    r1);\n    attributes.alpha = 0.0;\n    attributes.targetPosition = pos;\n   
    if (r2 < gather)\n    {\n        float life = lerp(1.0, 1.8, r0);\n        float3
    off = (n * 0.6 + rnd * 0.5 - normalize(wind + 1e-4) * 0.5) * travel * lerp(0.6,
    1.3, r1);\n        attributes.lifetime = life;\n        attributes.position =
    pos + off;\n        attributes.velocity = -off / life;\n        attributes.mass
    = 2.0;\n    }\n    else\n    {\n        attributes.lifetime = lerp(1.6, 3.0,
    r0);\n        attributes.position = pos + n * 0.02;\n        attributes.velocity
    = n * 0.04 + wind * lerp(0.2, 0.45, r1) + rnd * 0.03;\n        attributes.mass
    = 1.0;\n    }\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SandPuffInit
    selectedIndex: 0
