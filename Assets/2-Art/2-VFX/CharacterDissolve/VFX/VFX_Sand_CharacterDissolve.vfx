  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966680618}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966680694}
  - {fileID: 114350483966680695}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966680699}
  m_BlockName: Sand Puff Update
  m_HLSLCode: "void SandPuffUpdate(inout VFXAttributes attributes, in float dt, in
    float3 wind)\n{\n    float life = saturate(attributes.age / max(attributes.lifetime,
    1e-3));\n    if (attributes.mass > 1.5)\n    {\n        attributes.alpha = 0.06
    * smoothstep(0.0, 0.35, life) * (1.0 - smoothstep(0.7, 1.0, life));\n       
    float s = lerp(1.4, 0.5, life);\n        attributes.scaleX = s;\n        attributes.scaleY
    = s;\n    }\n    else\n    {\n        attributes.velocity += wind * 0.4 * dt;\n       
    attributes.velocity *= exp(-0.4 * dt);\n        attributes.alpha = 0.08 * smoothstep(0.0,
    0.2, life) * (1.0 - smoothstep(0.45, 1.0, life));\n        float s = lerp(0.6,
    1.7, life);\n        attributes.scaleX = s;\n        attributes.scaleY = s;\n   
    }\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SandPuffUpdate
    selectedIndex: 0
