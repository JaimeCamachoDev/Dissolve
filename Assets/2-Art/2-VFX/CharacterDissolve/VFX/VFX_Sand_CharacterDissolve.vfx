  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966680743}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966680819}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966680820}
  m_BlockName: Sand Glitter Update
  m_HLSLCode: "void SandGlitterUpdate(inout VFXAttributes attributes, in float dt)\n{\n   
    uint id = attributes.particleId * 23u + 5u;\n    float r = FixedRand(id + 7u);\n   
    float life = saturate(attributes.age / max(attributes.lifetime, 1e-3));\n   
    float tw = 0.5 + 0.5 * sin(attributes.age * (8.0 + 12.0 * r) + r * 6.2831);\n   
    attributes.alpha = tw * tw * smoothstep(0.0, 0.1, life) * (1.0 - smoothstep(0.6,
    1.0, life));\n    attributes.velocity *= exp(-0.8 * dt);\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SandGlitterUpdate
    selectedIndex: 0
