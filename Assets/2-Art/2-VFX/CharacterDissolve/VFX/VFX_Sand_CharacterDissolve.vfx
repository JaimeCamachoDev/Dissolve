  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966680484}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966680565}
  - {fileID: 114350483966680566}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966680570}
  m_BlockName: Sand Grain Update
  m_HLSLCode: "void SandGrainUpdate(inout VFXAttributes attributes, in float dt,
    in float3 wind)\n{\n    float life = saturate(attributes.age / max(attributes.lifetime,
    1e-3));\n    float s;\n    if (attributes.mass > 1.5)\n    {\n        // Converge:
    velocidad constante de Init (llega justo al final de su vida)\n        s = smoothstep(0.0,
    0.3, life) * (1.0 - smoothstep(0.92, 1.0, life));\n    }\n    else\n    {\n       
    attributes.velocity += (wind * 0.6 + float3(0, -0.12, 0)) * dt;\n        attributes.velocity
    *= exp(-0.6 * dt);\n        s = 1.0 - smoothstep(0.55, 1.0, life);\n    }\n   
    attributes.scaleX = s;\n    attributes.scaleY = s;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SandGrainUpdate
    selectedIndex: 0
